+// Stack: identities are cached by a node's position in the layout. A fresh
+// identity per render made SwiftUI replace every view on each Live Activity
+// update, so nothing could animate (e.g. contentTransition(.numericText)).
+enum NodeIdentityCache {
+  private static let lock = NSLock()
+  private static var identities: [String: NodeIdentityWrapper] = [:]
+
+  static func identity(for path: String) -> NodeIdentityWrapper {
+    lock.lock()
+    defer { lock.unlock() }
+    if let existing = identities[path] {
+      return existing
+    }
+    let created = NodeIdentityWrapper(id: UUID())
+    identities[path] = created
+    return created
+  }
+}
