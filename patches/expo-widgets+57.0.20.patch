+// Stack evaluates a pure presentation callback before notifying React Native.
+// LiveActivityIntent runs in the host process without presenting the host UI.
+@available(iOS 17.0, *)
+struct StackWorkoutLiveActivityInteraction: LiveActivityIntent {
+  static var title: LocalizedStringResource = "Update workout"
+  static var isDiscoverable: Bool = false
+  static var openAppWhenRun: Bool = false
+  static var authenticationPolicy: IntentAuthenticationPolicy = .alwaysAllowed
+  @Parameter(title: "source") var source: String?
+  @Parameter(title: "target") var target: String?
+  init() {}
+  init(source: String?, target: String?) { self.source = source; self.target = target }
+  func perform() async throws -> some IntentResult {
+    let trace = StackLATrace()
+    trace.begin("intentPerform")
+    defer { trace.end("intentPerform") }
+    if let source, let target, target.hasPrefix("stack.workout.v2:") {
+      trace.mark("intentDispatch", detail: "action=\(target.split(separator: "#").last ?? "?")")
+      try await StackLiveActivityPresentation.shared.press(source: source, target: target, trace: trace)
+    }
+    return .result()
+  }
+}
+
+// Every press AND authoritative write shares this serial task chain. Actor
+// isolation alone would allow reentrancy while awaiting ActivityKit.update.
+@available(iOS 16.2, *)
+actor StackLiveActivityPresentation {
+  static let shared = StackLiveActivityPresentation()
+  private var tail: Task<Void, Never>?
+  private var latest: [String: [String: Any]] = [:]
+
+  func press(source: String, target: String, trace: StackLATrace = StackLATrace()) async throws {
+    trace.begin("actorQueueWaitPress")
+    let previous = tail
+    let operation = Task {
+      await previous?.value
+      trace.end("actorQueueWaitPress")
+      try await self.applyPress(source: source, target: target, trace: trace)
+    }
+    tail = Task { _ = try? await operation.value }
+    try await operation.value
+  }
+
+  func reconcile(source: String, props: String, staleDate: Date?) async throws {
+    let trace = StackLATrace()
+    trace.begin("actorQueueWaitReconcile")
+    let previous = tail
+    let operation = Task {
+      await previous?.value
+      trace.end("actorQueueWaitReconcile")
+      try await self.applyAuthoritative(source: source, props: props, staleDate: staleDate, trace: trace)
+    }
+    tail = Task { _ = try? await operation.value }
+    try await operation.value
+  }
+
+  private func activity(_ source: String) -> Activity<LiveActivityAttributes>? {
+    Activity<LiveActivityAttributes>.activities.first {
+      $0.id == source && ($0.activityState == .active || $0.activityState == .stale) &&
+        $0.content.state.name == "StackWorkoutLiveActivity"
+    }
+  }
+  private func decode(_ string: String) throws -> [String: Any] {
+    guard let data = string.data(using: .utf8),
+      let props = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+      throw CocoaError(.coderReadCorrupt)
+    }
+    return props
+  }
+  private func encode(_ props: [String: Any]) throws -> String {
+    let data = try JSONSerialization.data(withJSONObject: props)
+    guard let value = String(data: data, encoding: .utf8) else { throw CocoaError(.coderInvalidValue) }
+    let content = LiveActivityAttributes.ContentState(name: "StackWorkoutLiveActivity", props: value)
+    guard try JSONEncoder().encode(content).count <= 4096 else { throw CocoaError(.coderInvalidValue) }
+    return value
+  }
+
+  private func applyPress(source: String, target: String, trace: StackLATrace) async throws {
+    trace.begin("pressProcessing")
+    defer { trace.end("pressProcessing") }
+    trace.begin("activityAndLayoutLookup")
+    guard let activity = activity(source), activity.activityState == .active,
+      let layout = WidgetsStorage.getString(forKey: "__expo_widgets_live_activity_StackWorkoutLiveActivity_layout") else {
+        trace.end("activityAndLayoutLookup")
+        return
+      }
+    trace.end("activityAndLayoutLookup")
+    trace.begin("currentPresentationDecode")
+    let current = try latest[source] ?? decode(activity.content.state.props)
+    trace.end("currentPresentationDecode")
+    // SDK 57's press walker accepts a widget root, not the Live Activity regions
+    // object. Evaluate its banner root; both surfaces use identical callbacks.
+    let callbackLayout = "(function(props, environment) { return (\(layout))(props, environment).banner; })"
+    trace.begin("jsTotal")
+    let result = evaluateWidgetButtonPress(layout: callbackLayout, props: current,
+      environment: ["target": target, "timestamp": Int(Date().timeIntervalSince1970 * 1000)], trace: trace)
+    trace.end("jsTotal")
+    let updated: [String: Any]
+    switch result {
+    case .success(let value):
+      guard let value else { return } // An old set/disabled Done no longer has this target.
+      updated = current.merging(value) { _, new in new }
+    case .failure(let error): throw error
+    }
+    // Validate serialization before accepting the action. Journal before display.
+    trace.begin("optimisticMergeAndValidation")
+    var next = updated
+    next["_stackRevision"] = Int.max // Reserve space before journaling.
+    _ = try encode(next)
+    trace.end("optimisticMergeAndValidation")
+    let event = try WidgetsEvents.shared.enqueueStackAction(source: source, target: target, trace: trace)
+    trace.mark("journalPersisted", detail: "command=\(event["id"] ?? "?") revision=\(event["sequence"] ?? "?")")
+    trace.begin("optimisticStateEncode")
+    next["_stackRevision"] = event["sequence"]
+    let encoded = try encode(next)
+    latest[source] = next
+    let state = LiveActivityAttributes.ContentState(name: activity.content.state.name, props: encoded)
+    trace.end("optimisticStateEncode")
+    trace.begin("activityUpdateOptimistic")
+    await activity.update(ActivityContent(state: state, staleDate: activity.content.staleDate))
+    trace.end("activityUpdateOptimistic")
+    trace.mark("optimisticUpdateReturned", detail: "command=\(event["id"] ?? "?")")
+    WidgetsEvents.shared.sendNotification(type: .userEvent, data: event, trace: trace)
+  }
+
+  private func applyAuthoritative(source: String, props: String, staleDate: Date?, trace: StackLATrace) async throws {
+    trace.begin("authoritativeReconcile")
+    defer { trace.end("authoritativeReconcile") }
+    guard let activity = activity(source) else { return }
+    trace.begin("reconcileDecodeAndRevision")
+    let incoming = try decode(props)
+    let current = try latest[source] ?? decode(activity.content.state.props)
+    let localRevision = current["_stackRevision"] as? Int ?? 0
+    let acknowledgement = incoming["acknowledgedRevision"] as? Int ?? 0
+    trace.end("reconcileDecodeAndRevision")
+    // An earlier host snapshot must not erase a newer local tap. A rejected action
+    // still consumes its command, so the following authoritative update corrects it.
+    trace.begin("reconcilePendingCheck")
+    let hasPending = try WidgetsEvents.shared.hasPendingStackActions(source: source, trace: trace)
+    trace.end("reconcilePendingCheck")
+    guard !hasPending, acknowledgement >= localRevision else {
+      trace.mark("reconcileSkipped", detail: "ack=\(acknowledgement) local=\(localRevision) pending=\(hasPending)")
+      return
+    }
+    trace.mark("reconcileAccepted", detail: "ack=\(acknowledgement) local=\(localRevision)")
+    latest[source] = incoming
+    let state = LiveActivityAttributes.ContentState(name: activity.content.state.name, props: props)
+    trace.begin("activityUpdateAuthoritative")
+    await activity.update(ActivityContent(state: state, staleDate: staleDate))
+    trace.end("activityUpdateAuthoritative")
+  }
+}
