@@ -0,0 +1,58 @@
+import Foundation
+import os.signpost
+
+// Debug-only Points of Interest. The UUID joins intent/actor stages; the
+// command UUID and revision emitted after journal append join later RN stages.
+public final class StackLATrace: @unchecked Sendable {
+  let id: String
+  #if DEBUG || STACK_LIVE_ACTIVITY_PROFILE
+  private static let log = OSLog(subsystem: "com.liftwithstack.stack", category: "LiveActivityLatency")
+  private let signpostID = OSSignpostID(log: log)
+  private let lock = NSLock()
+  private var intervals: [String: OSSignpostID] = [:]
+  #endif
+
+  init() {
+    #if DEBUG || STACK_LIVE_ACTIVITY_PROFILE
+    id = UUID().uuidString
+    #else
+    id = ""
+    #endif
+  }
+
+  func begin(_ stage: String) {
+    #if DEBUG || STACK_LIVE_ACTIVITY_PROFILE
+    let intervalID = OSSignpostID(log: Self.log)
+    lock.lock()
+    intervals[stage] = intervalID
+    lock.unlock()
+    os_signpost(.begin, log: Self.log, name: "LiveActivityStage", signpostID: intervalID,
+      "%{public}s trace=%{public}s", stage, id)
+    #endif
+  }
+
+  func end(_ stage: String) {
+    #if DEBUG || STACK_LIVE_ACTIVITY_PROFILE
+    lock.lock()
+    let intervalID = intervals.removeValue(forKey: stage)
+    lock.unlock()
+    guard let intervalID else { return }
+    os_signpost(.end, log: Self.log, name: "LiveActivityStage", signpostID: intervalID,
+      "%{public}s trace=%{public}s", stage, id)
+    #endif
+  }
+
+  func mark(_ stage: String, detail: String = "") {
+    #if DEBUG || STACK_LIVE_ACTIVITY_PROFILE
+    os_signpost(.event, log: Self.log, name: "LiveActivityMark", signpostID: signpostID,
+      "%{public}s trace=%{public}s %{public}s", stage, id, detail)
+    #endif
+  }
+
+  static func bridge(_ stage: String, commandId: String = "", detail: String = "") {
+    #if DEBUG || STACK_LIVE_ACTIVITY_PROFILE
+    os_signpost(.event, log: log, name: "LiveActivityBridge",
+      "%{public}s command=%{public}s %{public}s", stage, commandId, detail)
+    #endif
+  }
+}
