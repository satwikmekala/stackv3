{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "three": [
        "./node_modules/@types/three"
      ],
      "@/*": [
        "../*"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
