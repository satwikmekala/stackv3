# Required. Set on Railway only; never in the mobile app.
OPENROUTER_API_KEY=

# Optional (defaults shown)
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_PROVIDER_SORT=price          # price | throughput | latency
# OPENROUTER_ALLOW_DATA_COLLECTION=false  # false = only providers that don't store/train on prompts
# OPENROUTER_REASONING=false
# OPENROUTER_MAX_OUTPUT_TOKENS=8000
# AI_TIMEOUT_MS=60000
# REQUEST_DEADLINE_MS=90000
# AI_MAX_ATTEMPTS=2
# MAX_TEXT_LENGTH=10000
# MAX_BODY_BYTES=65536
# RATE_LIMIT_PER_MINUTE=10                # per client address; 0 disables
# STACK_CLIENT_KEY=                       # if set, clients must send x-stack-client-key
# TRUST_PROXY=true

# Routine sharing. Attach a Railway volume at /data before setting this path.
# No path => share creation/retrieval return 503; parsing still works.
# On Railway, a configured path outside RAILWAY_VOLUME_MOUNT_PATH stops startup.
# ROUTINE_SHARES_DB_PATH=/data/routine-shares.sqlite
ROUTINE_SHARE_PUBLIC_ORIGIN=https://liftwithstack.com
# ROUTINE_SHARE_RATE_LIMIT_PER_MINUTE=10   # separate from parse rate limit; 0 disables
# Share request bodies are capped at the unchanged V1 limit of 32768 UTF-8 bytes.
# Apple app identifier verified locally; confirm against the production archive.
STACK_IOS_APP_ID=4JMBGPRDZG.com.liftwithstack.stack
# Verified production App Store listing only. Empty hides Get Stack.
STACK_APP_STORE_URL=
